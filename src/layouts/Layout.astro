---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  image = "/Logo.svg",
  schema,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.defaultTitle;
const canonical = new URL(path, Astro.site ?? site.url);
const socialImage = new URL(image, Astro.site ?? site.url);
const schemaGraph = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: site.url,
    email: site.email,
    sameAs: [site.linkedInUrl],
    description: site.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
  },
  ...(schema ? [schema] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#081a33" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <meta name="keywords" content="AI consultancy, AI solutions, agentic workflows, business process automation, workforce transformation" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body>
    <div class="relative isolate overflow-x-clip">
      <SiteHeader currentPath={Astro.url.pathname} />
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>
