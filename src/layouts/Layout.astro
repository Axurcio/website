---
import "../styles/global.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title = "Axurcio — Forward Deployed Architect by Smart Tech Ventures" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>

    <meta name="description" content="Axurcio is the Forward Deployed Architect product from Smart Tech Ventures — Australia's leading AI architecture consultancy. We embed senior architects in your teams to drive strategic innovation with modern AI practices, governed by Arckit.org.">
    <meta name="author" content="Smart Tech Ventures">
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="keywords" content="Axurcio, Forward Deployed Architect, FDA, AI architecture, enterprise architecture governance, Arckit, Smart Tech Ventures, AI consulting Australia, agentic AI, AI transformation">
    <link rel="canonical" href="https://smarttechventures.au" />
    <link rel="icon" type="image/x-icon" href="/images/favicon.png">
    <meta property="og:locale" content="en_AU" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Axurcio | Forward Deployed Architect by Smart Tech Ventures" />
    <meta property="og:description"
        content="Axurcio embeds senior AI architects in your teams to design, build and govern production AI — powered by Arckit.org." />
    <meta property="og:url" content="https://smarttechventures.au" />
    <meta property="og:site_name" content="Smart Tech Ventures" />
    <meta property="og:image" content="https://smarttechventures.au/images/social-image.png" />
    <meta property="og:image:width" content="1124" />
    <meta property="og:image:height" content="854" />
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Axurcio — Forward Deployed Architect by Smart Tech Ventures">
    <meta name="twitter:description"
        content="Australia's leading AI architecture consultancy. Axurcio embeds senior architects who design, build and govern production AI.">
    <meta name="twitter:image" content="https://smarttechventures.au/images/social-image.png">
    <link rel="sitemap" href="/sitemap-index.xml" />

	<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  </head>
  <body class="bg-white font-SpaceGrotesk space-y-20">
    <Navbar />
    <slot />
    <Footer/>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.0/flowbite.min.js"></script>
  </body>
</html>
