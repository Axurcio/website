---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary" | "ghost";
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = "primary",
  external = false,
  class: className = "",
} = Astro.props;

const variants = {
  primary:
    "bg-slate-950 text-white shadow-soft hover:-translate-y-0.5 hover:bg-brand-600",
  secondary:
    "border border-slate-300 bg-white text-slate-950 hover:border-brand-300 hover:text-brand-700",
  ghost: "text-slate-700 hover:text-slate-950",
};
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition duration-200",
    variants[variant],
    className,
  ]}
>
  <span>{label}</span>
  {variant !== "ghost" && <span aria-hidden="true">-&gt;</span>}
</a>
