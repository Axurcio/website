---
interface Props {
  useCase: {
    title: string;
    sector: string;
    summary: string;
    impact: string[];
  };
}

const { useCase } = Astro.props;
---

<article class="surface-panel fade-up h-full border-l-4 border-l-accent-400 p-7" style="--delay: 120ms;">
  <div class="space-y-5">
    <div class="space-y-3">
      <span class="inline-flex rounded-md bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">
        {useCase.sector}
      </span>
      <h3 class="text-2xl font-semibold">{useCase.title}</h3>
      <p class="text-base leading-7 text-slate-600">{useCase.summary}</p>
    </div>

    <ul class="space-y-3">
      {useCase.impact.map((item) => (
        <li class="flex gap-3 text-sm leading-6 text-slate-600">
          <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-brand-500"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
