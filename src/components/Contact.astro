---
import Container from "./Container.astro"
---
<Container>
<div class="relative flex flex-col items-center md:flex-row">
    <div class="row items-center py-5 md:pr-16 md:w-4/12 md:py-10">
        <div class="text-center md:text-left space-y-3 bg-lime">
            <h2 class="text-4xl font-medium leading-none sm:text-6xl">Engage an FDA</h2>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-8/12 md:py-10">
        <p class="text-xl font-normal leading-7 text-center md:text-left">Tell us where you're stuck on AI — we'll scope a Forward Deployed Architect engagement</p>
    </div>
</div>

<div class="relative flex flex-col items-center md:flex-row my-6 bg-zinc-100 rounded-[45px]">
    <div class="row items-center py-12 px-4 md:px-20 md:w-8/12 md:py-10 space-y-5">
        <p class="text-lg">Email us at <a class="underline font-medium" href="mailto:hello@axurcio.com">hello@axurcio.com</a> or use the form on our <a class="underline font-medium" href="/contact">contact page</a>.</p>
        <a href="/contact" class="px-9 py-5 bg-zinc-900 hover:bg-lime text-white hover:text-black border border-zinc-900 rounded-2xl inline-flex">
            <span class="text-center text-xl font-normal leading-7">Book a discovery call</span>
        </a>
    </div>
    <div class="hidden md:grid md:justify-items-end md:w-4/12 md:py-2">
        <img src="./clients/contact.svg" alt="Contact Smart Tech Ventures" width="80%">
    </div>
</div>

</Container>