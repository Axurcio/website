---
import Container from "./Container.astro"
---
<Container>
<div class="relative flex flex-col items-center md:flex-row">
    <div class="row items-center py-5 md:pr-16 md:w-4/12 md:py-10">
        <div class="text-center md:text-left space-y-3 bg-lime">
            <h2 class="text-4xl font-medium leading-none sm:text-6xl">Testimonials</h2>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-8/12 md:py-10">
        <p class="text-xl font-normal leading-7 text-center md:text-left">What it's like to have a Forward Deployed Architect embedded in your team</p>
    </div>
</div>

<div class="flex-row items-center my-6 p-14 bg-black text-white rounded-[45px]">
    <div class="justify-items-center relative w-full border border-lime rounded-3xl">
        <div class="p-4 md:p-10">
            <p class="items-center justify-center text-white text-sm md:text-lg font-normal mb-4">"Smart Tech Ventures didn't hand us a strategy and walk away — their Forward Deployed Architect sat with our engineers and shipped a governed AI agent to production in under three months. The Arckit audit trail meant our risk team signed off without friction."</p>
            <span class="text-lime text-base md:text-xl font-medium">Head of Engineering<br/></span><span class="text-white text-lg font-normal">National financial services client</span>
        </div>
    </div>
</div>

</Container>