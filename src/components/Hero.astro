---
import Container from "./Container.astro"
---
<Container>
<div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-lime rounded-full text-sm font-medium">
                <span class="w-2 h-2 bg-black rounded-full"></span> A Smart Tech Ventures product
            </div>
            <h1 class="text-5xl font-medium leading-none md:text-6xl">Axurcio: a Forward Deployed Architect, embedded in your team</h1>
            <p class="mt-6 mb-8 text-xl font-normal leading-7 sm:mb-12">Axurcio places a senior AI architect from Smart Tech Ventures — Australia's leading AI architecture consultancy — inside your business to close the strategy-to-execution gap. We don't just advise: we design, build and ship production AI alongside your people, governed end-to-end by <a class="underline font-medium" href="https://arckit.org" target="_blank" rel="noopener">Arckit.org</a>.</p>
            <div class="flex flex-wrap gap-4">
                <a class="px-9 py-5 bg-zinc-900 hover:bg-lime text-white hover:text-black border border-zinc-900 rounded-2xl inline-flex" href="/contact">
                    <h2 class="text-center text-xl font-normal leading-7">Engage an FDA</h2>
                </a>
                <a class="px-9 py-5 bg-white hover:bg-black text-black hover:text-white border border-zinc-900 rounded-2xl inline-flex" href="/#services">
                    <h2 class="text-center text-xl font-normal leading-7">See how it works</h2>
                </a>
            </div>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <img src="/Hero.svg" width="100%" alt="Forward Deployed Architect embedded with your team"/>
    </div>
</div>

<div class="flex-row items-center">
    <p class="text-center text-sm uppercase tracking-widest text-zinc-500 mb-4">Architecting on the platforms you already run</p>
    <div class="grid grid-cols-3 sm:grid-cols-3 md:grid-cols-6">
        <div class="p-4 grayscale transition duration-200 hover:grayscale-0">
            <img src="/images/microsoft-partner-network.jpg" class="h-12 w-auto mx-auto" loading="lazy" alt="Microsoft" width="" height="" />
        </div>
        <div class="p-4 grayscale transition duration-200 hover:grayscale-0">
            <img src="/images/solutions/aws-parner-logo.jpg" class="h-12 w-auto mx-auto" loading="lazy" alt="AWS" width="" height="" />
        </div>
        <div class="p-4 flex grayscale transition duration-200 hover:grayscale-0">
            <img src="/images/solutions/gcp-partner.png" class="h-9 w-auto m-auto" loading="lazy" alt="Google Cloud" width="" height="" />
        </div>
        <div class="p-4 grayscale transition duration-200 hover:grayscale-0">
            <img src="/images/solutions/github-partner.png" class="h-12 w-auto mx-auto" loading="lazy" alt="GitHub" width="" height="" />
        </div>
        <div class="p-4 flex grayscale transition duration-200 hover:grayscale-0">
            <img src="/images/solutions/d365.jpg" class="h-8 w-auto m-auto" loading="lazy" alt="Dynamics 365" width="" height="" />
        </div>
        <div class="p-4 grayscale transition duration-200 hover:grayscale-0">
            <img src="/images/solutions/Salesforce.jpg" class="h-12 w-auto mx-auto" loading="lazy" alt="Salesforce" width="" height="" />
        </div>
    </div>
</div>
</Container>
