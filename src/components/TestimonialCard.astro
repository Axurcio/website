---
interface Props {
  testimonial: {
    quote: string;
    name: string;
    company: string;
  };
}

const { testimonial } = Astro.props;
---

<article class="dark-panel fade-up h-full p-8" style="--delay: 140ms;">
  <div class="flex h-full flex-col justify-between gap-8">
    <p class="text-lg leading-8 text-slate-200">"{testimonial.quote}"</p>
    <div class="space-y-1">
      <p class="text-sm font-semibold text-white">{testimonial.name}</p>
      <p class="text-sm text-slate-400">{testimonial.company}</p>
    </div>
  </div>
</article>
