---
import Container from "./Container.astro"

const outcomes = [
    {
        text: "For a national insurer, an embedded FDA designed and shipped a claims-triage agent to production in 11 weeks — cutting average handling time by 40% with full audit trails generated by Arckit.",
        tag: "Agentic automation"
    },
    {
        text: "For a WA government department, we stood up an AI governance harness and review gates so internal teams could ship generative AI safely against the Australian regulatory overlay.",
        tag: "Governed AI platform"
    },
    {
        text: "For an energy retailer, an FDA built a retrieval-augmented assistant over operational data, with evals and monitoring, lifting field-team self-service resolution to 70%.",
        tag: "RAG & reliability"
    }
];
---
<Container>
<div class="relative flex flex-col items-center md:flex-row" id="projects">
    <div class="row items-center py-5 md:pr-40 md:w-5/12 md:py-10">
        <div class="text-center md:text-left space-y-3 bg-lime">
            <h2 class="text-4xl font-medium leading-none sm:text-6xl">Outcomes</h2>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-7/12 md:py-10">
        <p class="text-xl font-normal leading-7 text-center md:text-left">Real production AI, shipped inside our clients' teams — not slideware. A sample of recent Axurcio engagements.</p>
    </div>
</div>

<div class="w-full p-12 bg-zinc-900 rounded-[45px] justify-start items-start gap-16 inline-flex text-white">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-2 divide-x-0 md:divide-x divide-y md:divide-y-0">
        {outcomes.map(o => (
        <div class="flex-col items-start gap-5 inline-flex px-2 md:px-6 py-6 md:py-2">
            <div class="text-lime text-sm font-medium uppercase tracking-widest">{o.tag}</div>
            <div class="w-full text-lg font-normal">{o.text}</div>
            <a href="/contact" class="justify-start items-center gap-[15px] inline-flex">
                <div class="text-lime text-xl font-normal leading-7">Talk to us</div>
                <img src="/services/agc.svg" alt="arrow">
            </a>
        </div>
        ))}
    </div>
</div>

</Container>
