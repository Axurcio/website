---
interface WorkflowStage {
  step: string;
  title: string;
  detail: string;
}

interface Props {
  stages: WorkflowStage[];
}

const { stages } = Astro.props;
---

<div class="dark-panel overflow-hidden p-6 sm:p-8">
  <div class="mb-8 flex items-center justify-between gap-4">
    <p class="panel-label">Operating Loop</p>
    <div class="hidden flex-1 sm:block">
      <div class="signal-line"></div>
    </div>
  </div>
  <div class="grid gap-4 lg:grid-cols-4">
    {stages.map((stage, index) => (
      <div class="relative space-y-4 rounded-lg border border-white/10 bg-white/[0.04] p-5 fade-up" style={`--delay:${index * 100}ms;`}>
        <div class="flex items-center gap-4">
          <span class="flex h-11 w-11 items-center justify-center rounded-md bg-accent-400 text-sm font-black text-ink">
            {stage.step}
          </span>
          {index < stages.length - 1 && (
            <span class="absolute left-[4.5rem] top-10 hidden h-px w-[calc(100%-3.5rem)] bg-gradient-to-r from-accent-400/90 to-brand-300/80 lg:block animate-pulse-line"></span>
          )}
        </div>
        <div class="space-y-3">
          <h3 class="text-xl font-semibold text-white">{stage.title}</h3>
          <p class="text-sm leading-7 text-slate-300">{stage.detail}</p>
        </div>
      </div>
    ))}
  </div>
</div>
