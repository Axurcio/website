---
interface WorkflowStage {
  step: string;
  title: string;
  detail: string;
}

interface Props {
  stages: WorkflowStage[];
}

const { stages } = Astro.props;
---

<div class="surface-panel overflow-hidden p-8 sm:p-10">
  <div class="grid gap-6 lg:grid-cols-4">
    {stages.map((stage, index) => (
      <div class="relative space-y-4 fade-up" style={`--delay:${index * 100}ms;`}>
        <div class="flex items-center gap-4">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950 text-sm font-semibold text-white">
            {stage.step}
          </span>
          {index < stages.length - 1 && (
            <span class="absolute left-16 top-6 hidden h-px w-[calc(100%-3rem)] bg-gradient-to-r from-brand-500/80 to-accent-300/80 lg:block animate-pulse-line"></span>
          )}
        </div>
        <div class="space-y-3">
          <h3 class="text-xl font-semibold">{stage.title}</h3>
          <p class="text-sm leading-7 text-slate-600">{stage.detail}</p>
        </div>
      </div>
    ))}
  </div>
</div>
