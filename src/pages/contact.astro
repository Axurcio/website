---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { contactHighlights, faqs, site } from "../data/site";
---

<Layout
  title="Contact"
  description="Book a consultation or send an enquiry to discuss AI solutions, agentic workflows, automation, and workforce transformation with Axurcio."
  path="/contact"
>
  <main>
    <PageHero
      eyebrow="Contact"
      title="Bring us the workflow, operating problem, or transformation priority you want to solve."
      description="Whether you need an AI strategy partner, an operational automation roadmap, or a working solution to deploy, Axurcio can help define the right next step."
      primaryCta={{ href: site.calendlyUrl, label: "Book a Consultation", external: true }}
      secondaryCta={{ href: `mailto:${site.email}`, label: "Email Axurcio" }}
    >
      <div slot="aside" class="surface-panel space-y-5 p-8">
        <p class="text-sm uppercase tracking-[0.22em] text-slate-500">Typical conversations</p>
        <ul class="space-y-4">
          {contactHighlights.map((highlight) => (
            <li class="flex gap-3 text-sm leading-7 text-slate-600">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-accent-400"></span>
              {highlight}
            </li>
          ))}
        </ul>
      </div>
    </PageHero>

    <section class="section-shell">
      <Container class="grid gap-8 xl:grid-cols-[1.1fr_0.9fr]">
        <ContactForm />

        <div class="space-y-6">
          <article class="dark-panel p-8">
            <div class="space-y-4">
              <p class="text-sm uppercase tracking-[0.22em] text-slate-400">Direct contact</p>
              <h2 class="text-2xl font-semibold text-white">Prefer to speak first?</h2>
              <p class="text-sm leading-7 text-slate-300">
                Email <a href={`mailto:${site.email}`} class="text-white underline underline-offset-4">{site.email}</a> or
                book time for an executive consultation. We can help you prioritise use cases,
                assess delivery paths, and map the next move.
              </p>
              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  href={site.calendlyUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-extrabold text-slate-950 transition hover:bg-slate-100"
                >
                  Book consultation
                  <span aria-hidden="true">-&gt;</span>
                </a>
                <a
                  href={`mailto:${site.email}`}
                  class="inline-flex items-center justify-center gap-2 rounded-md border border-white/15 px-5 py-3 text-sm font-extrabold text-white transition hover:border-white/30 hover:bg-white/5"
                >
                  Email Axurcio
                </a>
              </div>
            </div>
          </article>

          <article class="surface-panel p-8">
            <div class="space-y-5">
              <p class="text-sm uppercase tracking-[0.22em] text-slate-500">FAQ</p>
              <div class="space-y-4">
                {faqs.map((faq) => (
                  <details class="group rounded-lg border border-slate-200 bg-white p-5 open:border-brand-200 open:bg-brand-50/40">
                    <summary class="cursor-pointer list-none text-base font-semibold text-slate-950">
                      {faq.question}
                    </summary>
                    <p class="mt-3 text-sm leading-7 text-slate-600">{faq.answer}</p>
                  </details>
                ))}
              </div>
            </div>
          </article>
        </div>
      </Container>
    </section>
  </main>
</Layout>
