---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import ButtonLink from "../components/ButtonLink.astro";
import { deliveryPhases, principles, site } from "../data/site";
---

<Layout
  title="About"
  description="Learn how Axurcio approaches enterprise AI transformation with executive clarity, governed delivery, and operator-centric design."
  path="/about"
>
  <main>
    <PageHero
      eyebrow="About Axurcio"
      title="A practical AI partner for organisations navigating complex transformation."
      description="Axurcio exists to help leaders turn AI ambition into operating capability. We bring strategy, architecture, workflow design, and workforce change together so AI can create measurable value in the environments where complexity, governance, and execution all matter."
      primaryCta={{ href: "/contact", label: "Start a Conversation" }}
      secondaryCta={{ href: site.calendlyUrl, label: "Book a Consultation", external: true }}
    >
      <div slot="aside" class="surface-panel space-y-5 p-8">
        <p class="text-sm uppercase tracking-[0.22em] text-slate-500">What clients value</p>
        <ul class="space-y-4">
          <li class="flex gap-3 text-sm leading-7 text-slate-600">
            <span class="mt-2 h-2.5 w-2.5 rounded-full bg-brand-500"></span>
            Clear translation between executive goals, delivery choices, and operating impact
          </li>
          <li class="flex gap-3 text-sm leading-7 text-slate-600">
            <span class="mt-2 h-2.5 w-2.5 rounded-full bg-brand-500"></span>
            AI solution design that respects enterprise systems, governance, and service realities
          </li>
          <li class="flex gap-3 text-sm leading-7 text-slate-600">
            <span class="mt-2 h-2.5 w-2.5 rounded-full bg-brand-500"></span>
            Delivery support that helps teams adopt, scale, and sustain new ways of working
          </li>
        </ul>
      </div>
    </PageHero>

    <section class="section-shell">
      <Container class="space-y-10">
        <SectionIntro
          eyebrow="Approach"
          title="Axurcio combines consultancy-level thinking with implementation-minded delivery."
          description="We focus on the gap where many AI programs falter: between a promising idea and an operating model that teams can trust. That means staying close to outcomes, designing for the people who do the work, and treating governance as part of the solution."
        />
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {principles.map((principle, index) => (
            <article class="surface-panel fade-up p-8" style={`--delay:${index * 80}ms;`}>
              <h3 class="text-xl font-semibold">{principle.title}</h3>
              <p class="mt-4 text-sm leading-7 text-slate-600">{principle.description}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="section-shell">
      <Container class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionIntro
          eyebrow="How We Work"
          title="A delivery path designed for clarity, evidence, and scale."
          description="Every engagement is shaped to create momentum without losing rigour. We focus on identifying the right workflow, proving value quickly, and creating the operating conditions needed for responsible scale."
        />
        <div class="space-y-5">
          {deliveryPhases.map((phase, index) => (
            <article class="surface-panel fade-up p-8" style={`--delay:${index * 90}ms;`}>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950 text-sm font-semibold text-white">
                  0{index + 1}
                </span>
                <div>
                  <h3 class="text-xl font-semibold">{phase.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-slate-600">{phase.detail}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="section-shell">
      <Container>
        <div class="dark-panel grid gap-8 p-8 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="space-y-5">
            <span class="eyebrow border-white/10 bg-white/5 text-accent-200 before:bg-accent-300">
              Partnership Model
            </span>
            <h2 class="text-3xl font-semibold text-white sm:text-4xl">
              Senior, focused support for leaders tackling AI-enabled transformation.
            </h2>
            <p class="max-w-3xl text-base leading-8 text-slate-300">
              Axurcio works well with enterprise technology teams, operations leaders, innovation
              functions, and government organisations that need pragmatic guidance and credible
              execution support.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <ButtonLink href="/services" label="View Services" />
            <ButtonLink href="/contact" label="Contact Axurcio" variant="secondary" />
          </div>
        </div>
      </Container>
    </section>
  </main>
</Layout>
