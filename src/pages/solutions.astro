---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import WorkflowDiagram from "../components/WorkflowDiagram.astro";
import ButtonLink from "../components/ButtonLink.astro";
import { site, useCases, workflowStages } from "../data/site";
---

<Layout
  title="Solutions"
  description="See how Axurcio applies AI, automation, and agentic workflows to real enterprise and government use cases."
  path="/solutions"
>
  <main>
    <PageHero
      eyebrow="Solutions / Use Cases"
      title="Where AI creates leverage: practical use cases for complex organisations."
      description="Axurcio focuses on use cases that reduce friction, improve responsiveness, and redesign how work happens across operations, service delivery, and decision support."
      primaryCta={{ href: "/contact", label: "Discuss a Use Case" }}
      secondaryCta={{ href: "/services", label: "Review Services" }}
    >
      <div slot="aside" class="surface-panel space-y-5 p-8">
        <p class="text-sm uppercase tracking-[0.22em] text-slate-500">Common triggers</p>
        <ul class="space-y-4">
          <li class="flex gap-3 text-sm leading-7 text-slate-600">
            <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-brand-500"></span>
            Manual triage and repetitive decisioning slow the business down
          </li>
          <li class="flex gap-3 text-sm leading-7 text-slate-600">
            <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-brand-500"></span>
            Teams cannot keep up with volume without adding more coordination overhead
          </li>
          <li class="flex gap-3 text-sm leading-7 text-slate-600">
            <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-brand-500"></span>
            Leaders need better visibility, summarisation, and workflow acceleration
          </li>
        </ul>
      </div>
    </PageHero>

    <section class="section-shell">
      <Container class="space-y-8">
        <SectionIntro
          eyebrow="Solution Library"
          title="Use cases that demonstrate how Axurcio turns AI into operational advantage."
          description="These patterns are designed to be understandable to executives, actionable for delivery teams, and adaptable to enterprise controls."
        />

        <div class="space-y-6">
          {useCases.map((useCase, index) => (
            <article class="surface-panel overflow-hidden p-8 sm:p-10">
              <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
                <div class="space-y-4">
                  <span class="inline-flex rounded-md bg-brand-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">
                    {useCase.sector}
                  </span>
                  <h2 class="text-3xl font-semibold">{useCase.title}</h2>
                  <p class="text-base leading-8 text-slate-600">{useCase.summary}</p>
                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
                    <p class="text-sm uppercase tracking-[0.18em] text-slate-500">Challenge</p>
                    <p class="mt-3 text-sm leading-7 text-slate-600">{useCase.challenge}</p>
                  </div>
                </div>

                <div class="space-y-6">
                  <div class="rounded-lg border border-slate-200 bg-white p-6">
                    <p class="text-sm uppercase tracking-[0.18em] text-slate-500">Axurcio solution pattern</p>
                    <p class="mt-3 text-sm leading-7 text-slate-600">{useCase.solution}</p>
                  </div>

                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
                    <p class="text-sm uppercase tracking-[0.18em] text-slate-500">Business impact</p>
                    <ul class="mt-4 space-y-3">
                      {useCase.impact.map((item) => (
                        <li class="flex gap-3 text-sm leading-7 text-slate-600">
                          <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-accent-400"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="rounded-lg border border-brand-100 bg-brand-50/60 p-6">
                    <p class="text-sm uppercase tracking-[0.18em] text-brand-700">Implementation note</p>
                    <p class="mt-3 text-sm leading-7 text-slate-600">
                      {index % 2 === 0
                        ? "This pattern typically starts with a focused pilot, then expands to wider workflow orchestration, governance, and service integration."
                        : "This pattern usually benefits from combining process redesign, AI-assisted decision support, and clear role changes for the teams involved."}
                    </p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="section-shell">
      <Container class="space-y-10">
        <SectionIntro
          eyebrow="Agentic Pattern"
          title="The workflow pattern behind many of the strongest AI use cases."
          description="Regardless of sector, the core pattern is consistent: capture the right context, reason inside clear boundaries, act within approved systems, and learn from outcomes."
        />
        <WorkflowDiagram stages={workflowStages} />
      </Container>
    </section>

    <section class="section-shell pt-8">
      <Container>
        <div class="dark-panel grid gap-8 p-8 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="space-y-4">
            <span class="eyebrow border-white/10 bg-white/5 text-accent-200 before:bg-accent-300">
              Next Step
            </span>
            <h2 class="text-3xl font-semibold text-white sm:text-4xl">
              Have a specific workflow in mind?
            </h2>
            <p class="max-w-2xl text-base leading-8 text-slate-300">
              Bring the workflow, the bottleneck, or the decision problem. We can help shape the
              highest-value AI-enabled response.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <ButtonLink href="/contact" label="Talk Through a Use Case" />
            <ButtonLink href={site.calendlyUrl} label="Book a Consultation" variant="secondary" external />
          </div>
        </div>
      </Container>
    </section>
  </main>
</Layout>
