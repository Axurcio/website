---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SectionIntro from "../components/SectionIntro.astro";
import InsightCard from "../components/InsightCard.astro";
import { insights } from "../data/site";
---

<Layout
  title="Blog"
  description="Axurcio insights, articles, and practical thinking on AI transformation, automation, and agentic workflows."
  path="/blog"
>
  <main class="section-shell pt-16">
    <Container class="space-y-10">
      <SectionIntro
        eyebrow="Blog"
        title="Axurcio insights and articles."
        description="This route mirrors the main Insights hub so existing links continue to work while the site uses the new insights structure."
      />
      <div class="grid gap-6 lg:grid-cols-3">
        {insights.map((insight) => (
          <InsightCard insight={insight} />
        ))}
      </div>
    </Container>
  </main>
</Layout>
